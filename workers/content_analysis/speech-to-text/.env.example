SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-backend-only-key
WHISPER_CPP_EXE=tools/whisper-cuda/Release/whisper-cli.exe
WHISPER_CPP_MODEL=tools/ggml-small.bin
FFMPEG_EXE=tools/ffmpeg.exe
WHISPER_CPP_LANGUAGE=en
WHISPER_CPP_USE_GPU=true
TRANSCRIBE_TIMEOUT_SECONDS=7200
POLL_SECONDS=30
LEASE_SECONDS=900
RENEW_SECONDS=60
MAX_VIDEO_MB=1024


# Existing Supabase Storage bucket containing videos (required).
VIDEO_BUCKET=marketplace-videos
DISCOVERY_BATCH_SIZE=25

# Verified private PDF bucket (Reading resources only)
PDF_BUCKET=marketplace-documents
# Absolute local path containing eng.traineddata; never commit OCR models.
TESSDATA_PREFIX=
PDF_EXTRACT_TIMEOUT_SECONDS=600
